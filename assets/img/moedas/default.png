<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffd700"/>
      <stop offset="100%" style="stop-color:#ff9500"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="1" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <circle cx="20" cy="20" r="17" fill="none" stroke="url(#g)" stroke-width="2" filter="url(#glow)"/>
  <circle cx="20" cy="20" r="13" fill="none" stroke="url(#g)" stroke-width="1.5"/>
  <text x="20" y="25" text-anchor="middle" font-family="sans-serif" font-size="14" font-weight="bold" fill="url(#g)">$</text>
</svg>