<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#16213e"/>
    </linearGradient>
    <linearGradient id="neon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00ff88"/>
      <stop offset="50%" style="stop-color:#00d4ff"/>
      <stop offset="100%" style="stop-color:#a855f7"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <rect width="100" height="100" rx="16" fill="url(#bg)"/>
  <g transform="translate(18, 22)" filter="url(#glow)">
    <rect x="12" y="5" width="40" height="26" rx="8" fill="none" stroke="url(#neon)" stroke-width="3"/>
    <rect x="2" y="12" width="16" height="14" rx="6" fill="none" stroke="url(#neon)" stroke-width="2.5"/>
    <rect x="44" y="12" width="16" height="14" rx="6" fill="none" stroke="url(#neon)" stroke-width="2.5"/>
    <circle cx="22" cy="16" r="2.5" fill="#00ff88"/>
    <circle cx="17" cy="16" r="2.5" fill="#00d4ff"/>
    <circle cx="19.5" cy="11" r="2.5" fill="#a855f7"/>
    <circle cx="19.5" cy="21" r="2.5" fill="#ffd700"/>
    <line x1="42" y1="15" x2="48" y2="15" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="45" y1="12" x2="45" y2="18" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round"/>
  </g>
</svg>