# Asgard Store - Configuracao de Producao
# Copie para .env e ajuste os valores

# Banco de Dados
DB_HOST=localhost
DB_NAME=asgard_store
DB_USER=asgard_user
DB_PASS=sua_senha_segura_aqui

# Seguranca
DEBUG_MODE=false
CSRF_TOKEN_NAME=csrf_token
SESSION_LIFETIME=604800

# Upload
MAX_FILE_SIZE=5242880
MAX_SCREENSHOTS=5

# Negocio
COMISSAO_PADRAO=10
MINIMO_SAQUE=30
GARANTIA_HORAS=24

# Telegram Bot (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=asgard_store_webhook_secret_2026
